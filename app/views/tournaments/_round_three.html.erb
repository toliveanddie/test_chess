<% round_three_groups = tournament.round_three_participants.includes(:engine).map(&:engine).each_slice(9).to_a %>
<% round_three_groups.each_with_index do |group, index| %>
  <div class="card my-3">
    <div class="card-header bg-dark text-white">
      Group <%= index + 1 %>
    </div>
    <ul class="list-group list-group-flush">
      <% group.each do |engine| %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <%= engine.name %>
          <%= form_with url: round_three_participant_path(tournament.round_three_participants.find_by(engine_id: engine.id)), method: :delete, local: false, class: "d-inline" do |form| %>
            <%= form.submit "Remove", class: "btn btn-danger btn-sm", data: { confirm: "Are you sure you want to remove this engine from Round 3?" } %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
